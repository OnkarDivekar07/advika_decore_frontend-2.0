{
  "name": "advikadecore",
  "sideEffects": [
    "**/*.css",
    "./src/i18n/**",
    "./src/polyfills/**"
  ],
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
