VITE_API_URL=
VITE_RAZORPAY_KEY_ID=
# Absolute production origin (no trailing slash), e.g. https://shop.example.com
# Used to build canonical/Open Graph URLs and structured data (see
# src/seo/siteConfig.js#getSiteUrl) and by scripts/generate-sitemap.mjs.
# Safe to leave unset in development — canonical/OG URLs fall back to
# whatever origin the app is actually running on (window.location.origin).
VITE_SITE_URL=

